{
  "name": "assetforge",
  "version": "0.4.0",
  "description": "AssetForge — AI game asset pipeline for Unreal Engine 5: text-to-3D (Meshy), text-to-motion (Kimodo), motion matching & blend spaces, AI sound (ElevenLabs), ComfyUI textures, Blender automation and one-click UE5 import.",
  "keywords": [
    "unreal-engine",
    "ue5",
    "ai",
    "game-assets",
    "asset-pipeline",
    "text-to-3d",
    "text-to-motion",
    "motion-matching",
    "blend-space",
    "meshy",
    "kimodo",
    "elevenlabs",
    "comfyui",
    "blender",
    "mcp",
    "electron",
    "procedural-generation",
    "game-development"
  ],
  "author": "Hasan Erkan Uzun",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/HErkanuzun/AssetForge",
  "repository": {
    "type": "git",
    "url": "https://github.com/HErkanuzun/AssetForge.git"
  },
  "bugs": {
    "url": "https://github.com/HErkanuzun/AssetForge/issues"
  },
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/three": "^0.181.0",
    "@xyflow/react": "^12.12.0",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.181.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.assetforge.app",
    "productName": "AssetForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "AssetForge-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "AssetForge",
      "license": "build/license.txt"
    },
    "copyright": "Copyright (c) 2026 Hasan Erkan Uzun"
  },
  "productName": "AssetForge"
}
